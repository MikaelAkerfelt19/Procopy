@using Procopy.Models
@model List<Category>

@{
    ViewData["Title"] = "Kategoriler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // C# Local Function: Kendi kendini çağıran (rekürsif) metod ile Sınırsız Alt Kategori Ağacı Çizimi
    void RenderCategory(Category node, int level)
    {
        var marginLeft = level * 40; // Her kademede 40px sağa (içeri) kaydır
        var isRoot = level == 0;
        var bgColor = isRoot ? "bg-white" : "bg-light";
        var borderLeft = isRoot ? "4px solid #4e73df" : "4px solid #1cc88a";

        <div class="list-group-item @bgColor border mb-2 rounded shadow-sm" style="margin-left: @(marginLeft)px; border-left: @borderLeft !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div class="text-dark">
                    @if (isRoot)
                    {
                        <i class="fas fa-folder-open text-primary me-2" style="font-size: 1.2rem;"></i>
                        <strong style="font-size: 1.1rem;">@node.CategoryName</strong>
                    }
                    else
                    {
                        <i class="fas fa-level-up-alt fa-rotate-90 text-success me-2"></i>
                        <span class="fw-bold text-secondary">@node.CategoryName</span>
                    }

                    @if (!string.IsNullOrEmpty(node.ImportUrl))
                    {
                        <button onclick="botuBaslat(@node.CategoryId)" class="btn btn-sm text-white ms-2" style="background-color: #6f42c1; border:none;" title="Botu Çalıştır">
                            <i class="fas fa-play-circle me-1"></i> Bot
                        </button>
                    }
                </div>
                <div>
                    <a href="/Admin/Admin/ChangeOrder?id=@node.CategoryId&direction=up" class="btn btn-sm btn-outline-secondary py-0 px-1" title="Yukarı Taşı"><i class="fas fa-arrow-up"></i></a>
                    <a href="/Admin/Admin/ChangeOrder?id=@node.CategoryId&direction=down" class="btn btn-sm btn-outline-secondary py-0 px-1 me-2" title="Aşağı Taşı"><i class="fas fa-arrow-down"></i></a>

                    <a href="/Admin/Admin/CategoryCreate?parentId=@node.CategoryId" class="btn btn-sm btn-success py-1" style="font-size: 0.8rem;">
                        <i class="fas fa-plus"></i> Alt Ekle
                    </a>

                    <a href="/Admin/Admin/CategoryEdit?id=@node.CategoryId" class="btn btn-sm btn-warning py-1 ms-1" style="font-size: 0.8rem;">Düzenle</a>
                    <a href="/Admin/Admin/DeleteCategory?id=@node.CategoryId" class="btn btn-sm btn-danger py-1 ms-1" style="font-size: 0.8rem;" onclick="return confirm('Silmek istediğine emin misin?')">Sil</a>
                </div>
            </div>
        </div>

        // EĞER bu kategorinin de altında alt-kategoriler varsa, fonksiyon KENDİ KENDİNİ tekrar çalıştırır! (Sınırsız Döngü)
        if (node.Children != null && node.Children.Any())
        {
            foreach (var child in node.Children.OrderBy(x => x.DisplayOrder))
            {
                RenderCategory(child, level + 1);
            }
        }
    }
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Kategori Ağacı (Sınırsız Derinlik)</h6>
        <a href="/Admin/Admin/CategoryCreate" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Yeni Ana Kategori
        </a>
    </div>

    <div class="card-body" style="background-color: #f8f9fc;">
        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger">@TempData["Hata"]</div>
        }

        <div class="list-group list-group-flush">
            @* Sadece En Üst (Ana) kategorileri döngüye sokuyoruz, diğerleri otomatik aşağıya dizilecek *@
            @foreach (var anaKategori in Model)
            {
                RenderCategory(anaKategori, 0);
            }
        </div>
    </div>
</div>

<div class="modal fade" id="botSonucModal" tabindex="-1" aria-labelledby="botModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="botModalLabel">
                    <i class="fas fa-robot"></i> Bot İşlem Raporu
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" id="botModalBody">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
                        <span class="visually-hidden">Yükleniyor...</span>
                    </div>
                    <h5 class="mt-3 text-muted">Veriler taranıyor, lütfen bekleyiniz...</h5>
                    <small>Bu işlem ürün sayısına göre 1-2 dakika sürebilir.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <a href="/Admin/Admin/Products" class="btn btn-success">Ürünlere Git</a>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function botuBaslat(id) {
        var myModal = new bootstrap.Modal(document.getElementById('botSonucModal'));
        myModal.show();

        $('#botModalBody').html(`
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;"></div>
                <h5 class="mt-3">Bot Çalışıyor...</h5>
                <p class="text-muted">Kategoriler ve ürünler taranıyor. Lütfen sayfayı kapatmayın.</p>
            </div>
        `);

        $.ajax({
            url: '/DataImport/StartTreeImport?mainCategoryId=' + id,
            type: 'GET',
            success: function(response) {
                $('#botModalBody').html(response);
            },
            error: function() {
                $('#botModalBody').html('<div class="alert alert-danger">Bir hata oluştu! Bot çalıştırılamadı.</div>');
            }
        });
    }
</script>