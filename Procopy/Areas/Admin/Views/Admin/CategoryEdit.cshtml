@model Procopy.Models.Category
@{
    ViewData["Title"] = "Kategori Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center bg-primary text-white">
        <h6 class="m-0 font-weight-bold"><i class="fas fa-edit me-2"></i>Kategoriyi Düzenle: @Model.CategoryName</h6>
        <a href="/Admin/Admin/CategoryList" class="btn btn-light btn-sm text-primary fw-bold"><i class="fas fa-arrow-left"></i> Listeye Dön</a>
    </div>
    <div class="card-body">
        <form method="post" action="/Admin/Admin/CategoryEdit">
            <input type="hidden" name="CategoryId" value="@Model.CategoryId" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Kategori Adı</label>
                    <input type="text" name="CategoryName" class="form-control" value="@Model.CategoryName" required>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">URL Yapısı (Slug)</label>
                    <input type="text" name="Slug" class="form-control" value="@Model.Slug">
                    <small class="text-muted">Boş bırakırsanız otomatik oluşur.</small>
                </div>
            </div>

            <div class="mb-4 p-3 border rounded" style="background-color: #f3f0ff; border-left: 5px solid #6f42c1 !important;">
                <label class="form-label fw-bold" style="color: #6f42c1;">
                    <i class="fas fa-robot me-1"></i> Veri Çekme Linki (Turkuaz vb.)
                </label>
                <input type="text" name="ImportUrl" class="form-control border-secondary" value="@Model.ImportUrl"
                       placeholder="Örn: https://www.turkuazpromosyon.com.tr/plastik-kalemler">
                <div class="form-text text-dark">
                    <i class="fas fa-info-circle text-primary"></i>
                    Buraya link girerseniz, kategori listesinde <b>"Bot"</b> butonu aktif olur.
                </div>
            </div>

            <div class="mb-3 form-check p-3 border rounded bg-light">
                <input type="checkbox" class="form-check-input" name="IsActive" value="true" @(Model.IsActive == true ? "checked" : "")>
                <label class="form-check-label fw-bold">Bu Kategori Sitede Gözüksün</label>
            </div>

            <hr>
            <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-save me-2"></i> Değişiklikleri Kaydet</button>
        </form>
    </div>
</div>