@using Procopy.Models
@model List<Product>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Ürün Yönetimi";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary">Ürün Listesi</h6>
        <a href="/Admin/Admin/Create" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i> Yeni Ürün Ekle
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                <thead class="table-light">
                    <tr>
                        <th>Ürün Adı</th>
                        <th>Kategori</th>
                        <th>Fiyat</th>
                        <th>Durum</th>
                        <th style="width: 180px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold">
                                    @item.ProductName
                                    @if (!string.IsNullOrEmpty(item.SourceUrl))
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-light text-muted border">
                                                <i class="fas fa-link"></i> Kaynak Bağlı
                                            </span>
                                        </div>
                                    }
                                </td>

                                <td>
                                    <span class="badge bg-info text-dark" style="font-size: 0.9em;">
                                        @(item.Category != null ? item.Category.CategoryName : "Kategorisiz")
                                    </span>
                                </td>

                                <td>@((item.Price ?? 0).ToString("C2"))</td>

                                <td>
                                    @if (item.IsActive == true)
                                    {
                                        <span class="badge bg-success">Yayında</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Pasif</span>
                                    }
                                </td>

                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="/Admin/Admin/Edit/@item.ProductId" class="btn btn-warning btn-sm" title="Ürünü Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        @if (!string.IsNullOrEmpty(item.SourceUrl))
                                        {
                                            <a href="/DataImport/PullFromSource?productId=@item.ProductId"
                                               class="btn btn-primary btn-sm"
                                               title="Verileri Güncelle"
                                               target="_blank">
                                                <i class="fas fa-sync-alt"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-secondary btn-sm" disabled title="Kaynak Link Yok">
                                                <i class="fas fa-link-slash"></i>
                                            </button>
                                        }

                                        <a href="/Admin/Admin/Delete/@item.ProductId"
                                           class="btn btn-danger btn-sm"
                                           title="Sil"
                                           onclick="return confirm('Bu ürünü silmek istediğinize emin misiniz?');">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-warning text-center mt-3">
                Henüz hiç ürün eklenmemiş. "Yeni Ürün Ekle" butonunu kullanarak başlayabilirsiniz.
            </div>
        }
    </div>
</div>