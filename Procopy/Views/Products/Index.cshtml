@using Procopy.Models
@model IEnumerable<Product>

@functions {
    string GetCategoryIcon(string categoryName)
    {
        if (string.IsNullOrEmpty(categoryName)) return "fa-solid fa-box";
        var name = categoryName.ToLowerInvariant();
        if (name.Contains("kalem")) return "fa-solid fa-pen";
        if (name.Contains("defter") || name.Contains("ajanda")) return "fa-solid fa-book";
        if (name.Contains("usb") || name.Contains("bellek")) return "fa-solid fa-usb";
        if (name.Contains("power") || name.Contains("şarj")) return "fa-solid fa-battery-full";
        if (name.Contains("termos") || name.Contains("bardak")) return "fa-solid fa-mug-hot";
        if (name.Contains("saat")) return "fa-solid fa-clock";
        if (name.Contains("çakmak")) return "fa-solid fa-fire";
        if (name.Contains("tekstil") || name.Contains("tişört") || name.Contains("şapka")) return "fa-solid fa-shirt";
        if (name.Contains("çanta") || name.Contains("sekreter")) return "fa-solid fa-briefcase";
        if (name.Contains("anahtarlık")) return "fa-solid fa-key";
        if (name.Contains("takvim")) return "fa-solid fa-calendar";
        if (name.Contains("bayrak")) return "fa-solid fa-flag";
        if (name.Contains("teknoloj")) return "fa-solid fa-microchip";
        if (name.Contains("matbaa") || name.Contains("baskı")) return "fa-solid fa-print";
        return "fa-solid fa-gift";
    }
}

@{
    ViewData["Title"] = ViewBag.PageTitle ?? "Ürünler";
    var categories = ViewBag.Categories as List<Category>;
    string currentSlug = ViewBag.CurrentSlug as string;
    var productGroups = ViewBag.ProductGroups as List<Procopy.Models.ProductGroupViewModel>;
    bool isGrouped = productGroups != null && productGroups.Any();
}

<div class="container py-5">
    <div class="row">

        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom-red py-3">
                    <h5 class="mb-0 fw-bold"><i class="fa-solid fa-list me-2 text-danger"></i>Kategoriler</h5>
                </div>

                <div class="accordion accordion-flush" id="categoryAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <a href="/Products" class="accordion-button shadow-none no-arrow @(string.IsNullOrEmpty(currentSlug) ? "text-danger fw-bold" : "text-dark")" style="background:none;">
                                Tüm Ürünler
                            </a>
                        </h2>
                    </div>

                    @if (categories != null)
                    {
                        foreach (var mainCat in categories.Where(c => c.ParentId == null && c.Slug != "indirimli-firsatlar"))
                        {
                            var subCats = categories.Where(c => c.ParentId == mainCat.CategoryId).ToList();
                            bool isActiveMain = (currentSlug == mainCat.Slug);
                            bool isActiveSub = subCats.Any(c => c.Slug == currentSlug);
                            bool isOpen = isActiveMain || isActiveSub;

                            <div class="accordion-item">
                                <h2 class="accordion-header">
                                    @if (subCats.Any())
                                    {
                                        <button class="accordion-button shadow-none @(isOpen ? "" : "collapsed")" type="button"
                                                data-bs-toggle="collapse" data-bs-target="#cat-@mainCat.CategoryId"
                                                aria-expanded="@(isOpen ? "true" : "false")">
                                            <span class="@(isOpen ? "text-danger fw-bold" : "text-dark")">@mainCat.CategoryName</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <a href="/Products?category=@mainCat.Slug"
                                           class="accordion-button shadow-none no-arrow @(isActiveMain ? "text-danger fw-bold" : "text-dark")"
                                           style="background:none;">
                                            @mainCat.CategoryName
                                        </a>
                                    }
                                </h2>

                                @if (subCats.Any())
                                {
                                    <div id="cat-@mainCat.CategoryId" class="accordion-collapse collapse @(isOpen ? "show" : "")" data-bs-parent="#categoryAccordion">
                                        <div class="accordion-body p-0">
                                            <div class="list-group list-group-flush">
                                                @foreach (var sub in subCats)
                                                {
                                                    <a href="/Products?category=@sub.Slug"
                                                       class="list-group-item list-group-item-action small ps-4 @(currentSlug == sub.Slug ? "active-sub" : "")">
                                                        <i class="fa-solid fa-angle-right me-1 text-muted" style="font-size:10px;"></i> @sub.CategoryName
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            <a href="/Products?category=indirimli-firsatlar"
               class="btn btn-danger w-100 py-3 mb-4 shadow-sm d-flex align-items-center justify-content-center text-white text-decoration-none">
                <i class="fa-solid fa-percent fa-lg me-2"></i>
                <span class="fw-bold">İNDİRİMLİ FIRSATLAR</span>
                <i class="fa-solid fa-arrow-right ms-auto"></i>
            </a>

            <div class="card bg-dark text-white p-4 shadow-sm border-0" style="background: linear-gradient(45deg, #1a1a1a, #333);">
                <h6 class="fw-bold text-danger mb-3">Özel Tasarım?</h6>
                <p class="small mb-3 text-light opacity-75">Aklınızdaki proje listede yok mu? Sizin için üretelim.</p>
                <a href="https://wa.me/+905523497350?text=Merhaba,%20özel%20tasarım%20projesi%20için%20yazıyorum."
                   target="_blank" class="btn btn-light w-100 fw-bold rounded-pill text-dark">
                    <i class="fa-brands fa-whatsapp me-2"></i>Teklif İste
                </a>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
                <h2 class="fw-bold">@ViewBag.PageTitle</h2>
                @if (!isGrouped)
                {
                    <span class="text-muted small">@ViewBag.TotalCount ürün — Sayfa @ViewBag.CurrentPage / @ViewBag.TotalPages</span>
                }
            </div>

            @if (isGrouped)
            {
                @* GRUPLU GÖRÜNÜM: Her alt kategori ayrı bölüm *@
                @foreach (var grup in productGroups)
                {
                    <div class="mb-5">
                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2" style="border-bottom: 2px solid var(--pro-red);">
                            <h4 class="fw-bold mb-0">
                                <i class="fa-solid fa-angle-right text-danger me-2" style="font-size:0.85em;"></i>
                                @grup.Category.CategoryName
                            </h4>
                            @if (grup.TotalCount > 8)
                            {
                                <a href="/Products?category=@grup.Category.Slug"
                                   class="btn btn-outline-danger btn-sm rounded-pill">
                                    Tümünü Gör (@grup.TotalCount) <i class="fa-solid fa-arrow-right ms-1"></i>
                                </a>
                            }
                        </div>
                        <div class="row g-3">
                            @foreach (var item in grup.Products)
                            {
                                <div class="col-6 col-md-4 col-lg-3">
                                    <div class="card product-card h-100 border-0 shadow-sm">
                                        <a asp-action="Details" asp-route-id="@item.ProductCode" class="d-block text-decoration-none stretched-link">
                                            @if (!string.IsNullOrEmpty(item.MainImageUrl))
                                            {
                                                <img src="@item.MainImageUrl"
                                                     class="card-img-top p-2 hover-zoom"
                                                     alt="@item.ProductName"
                                                     style="height:170px; object-fit:contain;" />
                                            }
                                            else
                                            {
                                                <div class="d-flex align-items-center justify-content-center"
                                                     style="height:170px; background:linear-gradient(135deg,#f8f9fa,#e9ecef);">
                                                    <i class="@GetCategoryIcon(item.Category?.CategoryName) fa-2x text-danger opacity-75"></i>
                                                </div>
                                            }
                                        </a>
                                        <div class="card-body p-2 text-center">
                                            <p class="mb-1 fw-semibold" style="font-size:0.75rem; line-height:1.3;">@item.ProductName</p>
                                            @if (item.Price.HasValue && item.Price.Value > 0)
                                            {
                                                <span class="text-primary fw-bold small">@item.Price.Value.ToString("C2")</span>
                                            }
                                            else
                                            {
                                                <span class="text-secondary small">Fiyat Sorunuz</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                @* DÜZ GÖRÜNÜM: Sayfalama ile tam liste *@
                <div class="row g-4">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div class="card product-card h-100 border-0 shadow-sm">
                                    <div class="position-relative overflow-hidden">
                                        <a asp-action="Details" asp-route-id="@item.ProductCode" class="d-block text-decoration-none">
                                            @if (!string.IsNullOrEmpty(item.MainImageUrl))
                                            {
                                                <div class="product-img-wrapper">
                                                    <img src="@item.MainImageUrl"
                                                         class="card-img-top p-3 hover-zoom"
                                                         alt="@item.ProductName"
                                                         style="height:250px; object-fit:contain;"
                                                         onerror="this.closest('.product-img-wrapper').innerHTML='<div class=\'product-no-img d-flex flex-column align-items-center justify-content-center text-center p-3\' style=\'height:250px;background:linear-gradient(135deg,#f8f9fa,#e9ecef);\'><i class=\'@GetCategoryIcon(item.Category?.CategoryName) fa-3x text-danger mb-3 opacity-75\'></i><span class=\'text-muted small fw-semibold px-2\' style=\'font-size:0.78rem\'>@Html.Raw(item.ProductName.Replace("'", "&#39;"))</span></div>';">
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="product-no-img d-flex flex-column align-items-center justify-content-center text-center p-3"
                                                     style="height:250px; background:linear-gradient(135deg,#f8f9fa 0%,#e9ecef 100%); border-radius:8px 8px 0 0;">
                                                    <i class="@GetCategoryIcon(item.Category?.CategoryName) fa-3x text-danger mb-3 opacity-75"></i>
                                                    <span class="text-muted small fw-semibold px-2" style="font-size:0.78rem; line-height:1.4;">@item.ProductName</span>
                                                </div>
                                            }
                                        </a>
                                    </div>
                                    <div class="card-body d-flex flex-column text-center">
                                        <small class="text-muted mb-1">@item.Category?.CategoryName</small>
                                        <h5 class="card-title h6 fw-bold mb-3">
                                            <a asp-action="Details" asp-route-id="@item.ProductCode" class="text-dark text-decoration-none">
                                                @item.ProductName
                                            </a>
                                        </h5>
                                        <div class="mt-auto">
                                            @if (item.Price.HasValue && item.Price.Value > 0)
                                            {
                                                @if (item.OldPrice.HasValue && item.OldPrice.Value > item.Price.Value)
                                                {
                                                    <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
                                                        <span class="text-muted text-decoration-line-through small">@item.OldPrice.Value.ToString("C2")</span>
                                                        <span class="text-danger fw-bold fs-5">@item.Price.Value.ToString("C2")</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <p class="text-primary fw-bold mb-3 fs-5">@item.Price.Value.ToString("C2")</p>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-secondary fw-bold mb-3 fs-6">Fiyat Sorunuz</p>
                                            }
                                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductCode"
                                               class="btn btn-light w-100 border stretched-link">İncele</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12 text-center py-5 bg-light rounded">
                            <i class="fa-regular fa-folder-open fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">Bu kategoride henüz ürün bulunmuyor.</h4>
                            <a href="/Products" class="btn btn-link">Tüm ürünleri gör</a>
                        </div>
                    }
                </div>

                @if (ViewBag.TotalPages > 1)
                {
                    <nav class="mt-5 d-flex justify-content-center">
                        <ul class="pagination">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="/Products?category=@ViewBag.Category&page=@(ViewBag.CurrentPage - 1)">
                                        <i class="fa-solid fa-chevron-left"></i>
                                    </a>
                                </li>
                            }
                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="/Products?category=@ViewBag.Category&page=@i">@i</a>
                                </li>
                            }
                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="/Products?category=@ViewBag.Category&page=@(ViewBag.CurrentPage + 1)">
                                        <i class="fa-solid fa-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }

        </div>
    </div>
</div>

<style>
    .no-arrow::after {
        display: none !important;
    }

    .active-sub {
        color: var(--pro-red) !important;
        background-color: #fceceebb !important;
        font-weight: 600;
        border-left: 3px solid var(--pro-red);
    }

    .accordion-button:not(.collapsed) {
        background-color: #fff;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,.125);
    }

    .accordion-button:focus {
        border-color: rgba(214,0,28,0.1);
        box-shadow: 0 0 0 0.25rem rgba(214,0,28,0.1);
    }

    .list-group-item {
        transition: 0.2s;
        border-left: 3px solid transparent;
    }

        .list-group-item:hover {
            background-color: #f8f9fa;
            border-left: 3px solid var(--pro-red);
            color: var(--pro-red);
        }

    .hover-zoom {
        transition: transform 0.3s ease;
    }

    .product-card:hover .hover-zoom {
        transform: scale(1.05);
    }

    .product-card {
        transition: box-shadow 0.3s;
    }

        .product-card:hover {
            box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        }

    .product-no-img {
        transition: background 0.3s;
    }

    .product-card:hover .product-no-img {
        background: linear-gradient(135deg, #fcecea 0%, #f5d5d5 100%) !important;
    }

    .border-bottom-red {
        border-bottom: 2px solid var(--pro-red);
    }
</style>