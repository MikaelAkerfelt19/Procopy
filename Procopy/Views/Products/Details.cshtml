@model Procopy.Models.Product

@functions {
    string GetCategoryIcon(string categoryName)
    {
        if (string.IsNullOrEmpty(categoryName)) return "fa-solid fa-box";
        var name = categoryName.ToLowerInvariant();
        if (name.Contains("kalem")) return "fa-solid fa-pen";
        if (name.Contains("defter") || name.Contains("ajanda")) return "fa-solid fa-book";
        if (name.Contains("usb") || name.Contains("bellek")) return "fa-solid fa-usb";
        if (name.Contains("power") || name.Contains("sarj")) return "fa-solid fa-battery-full";
        if (name.Contains("termos") || name.Contains("bardak")) return "fa-solid fa-mug-hot";
        if (name.Contains("saat")) return "fa-solid fa-clock";
        if (name.Contains("cakmak")) return "fa-solid fa-fire";
        if (name.Contains("tekstil") || name.Contains("tisort") || name.Contains("sapka")) return "fa-solid fa-shirt";
        if (name.Contains("canta") || name.Contains("sekreter")) return "fa-solid fa-briefcase";
        if (name.Contains("anahtarlik")) return "fa-solid fa-key";
        if (name.Contains("takvim")) return "fa-solid fa-calendar";
        if (name.Contains("bayrak")) return "fa-solid fa-flag";
        if (name.Contains("teknoloj")) return "fa-solid fa-microchip";
        if (name.Contains("matbaa") || name.Contains("baski")) return "fa-solid fa-print";
        return "fa-solid fa-gift";
    }
}

@{
    ViewData["Title"] = Model.ProductName;
    var related = ViewBag.RelatedProducts as List<Procopy.Models.Product>;
    string waNumber = "905523497350";
    string waText = Uri.EscapeDataString($"Merhaba, {Model.ProductCode} kodlu \"{Model.ProductName}\" ürünü hakkında bilgi almak istiyorum.");
}

<div class="container py-5">

    @* Breadcrumb *@
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="/" class="text-danger text-decoration-none">Ana Sayfa</a>
            </li>
            <li class="breadcrumb-item">
                <a href="/Products?category=@Model.Category?.Slug" class="text-danger text-decoration-none">
                    @Model.Category?.CategoryName
                </a>
            </li>
            <li class="breadcrumb-item active text-muted">@Model.ProductName</li>
        </ol>
    </nav>

    @* Ana Ürün Kartı *@
    <div class="row g-5 mb-5">

        @* Sol: Görsel *@
        <div class="col-lg-5">
            <div class="product-image-wrapper border rounded-4 bg-white shadow-sm text-center p-4">
                @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                {
                    <img src="@Model.MainImageUrl"
                         id="main-product-img"
                         class="img-fluid product-main-img"
                         alt="@Model.ProductName"
                         style="max-height:420px; object-fit:contain;"
                         onerror="this.style.display='none'; document.getElementById('img-fallback').style.display='flex';">
                    <div id="img-fallback"
                         class="flex-column align-items-center justify-content-center text-center p-3"
                         style="display:none; height:420px; background:linear-gradient(135deg,#f8f9fa,#e9ecef); border-radius:12px;">
                        <i class="@GetCategoryIcon(Model.Category?.CategoryName) fa-5x text-danger mb-3 opacity-75"></i>
                        <span class="text-muted small fw-semibold">@Model.ProductName</span>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center p-3"
                         style="height:420px; background:linear-gradient(135deg,#f8f9fa,#e9ecef); border-radius:12px;">
                        <i class="@GetCategoryIcon(Model.Category?.CategoryName) fa-5x text-danger mb-3 opacity-75"></i>
                        <span class="text-muted small fw-semibold px-2">@Model.ProductName</span>
                    </div>
                }
            </div>
        </div>

        @* Sağ: Bilgiler *@
        <div class="col-lg-7 d-flex flex-column justify-content-center">

            @* Kategori rozeti *@
            <span class="badge bg-danger bg-opacity-10 text-danger mb-3 px-3 py-2 rounded-pill"
                  style="width:fit-content; font-size:.8rem;">
                <i class="fa-solid fa-tag me-1"></i>@Model.Category?.CategoryName
            </span>

            <h1 class="fw-bold mb-2" style="font-size:1.8rem;">@Model.ProductName</h1>

            <p class="text-muted mb-4">
                <i class="fa-solid fa-barcode me-1"></i>
                Ürün Kodu: <strong class="text-dark">@Model.ProductCode</strong>
            </p>

            @* Fiyat Kutusu *@
            <div class="price-box p-4 rounded-3 mb-4"
                 style="background:#f8f9fa; border-left:4px solid var(--pro-red, #d6001c);">
                @if (Model.Price.HasValue && Model.Price.Value > 0)
                {
                    @if (Model.OldPrice.HasValue && Model.OldPrice.Value > Model.Price.Value)
                    {
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <span class="text-muted text-decoration-line-through fs-5">
                                @Model.OldPrice.Value.ToString("C2")
                            </span>
                            <span class="text-danger fw-bold" style="font-size:2rem;">
                                @Model.Price.Value.ToString("C2")
                            </span>
                            <span class="badge bg-danger fs-6">
                                -%@(Math.Round((1 - Model.Price.Value / Model.OldPrice.Value) * 100))
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="text-danger fw-bold" style="font-size:2rem;">
                                @Model.Price.Value.ToString("C2")
                            </span>
                            <span class="text-muted small">+ KDV</span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-secondary fw-bold fs-5 mb-0">
                        <i class="fa-solid fa-phone-volume me-2 text-danger"></i>Fiyat için arayınız
                    </p>
                }
            </div>

            @* Butonlar *@
            <div class="d-flex flex-column flex-sm-row gap-3 mb-4">
                <a href="https://wa.me/@waNumber?text=@waText"
                   target="_blank"
                   class="btn btn-success btn-lg px-4 d-flex align-items-center justify-content-center gap-2 rounded-pill shadow-sm">
                    <i class="fa-brands fa-whatsapp fa-lg"></i>
                    <span>WhatsApp ile Teklif Al</span>
                </a>
                <a href="tel:+905523497350"
                   class="btn btn-outline-dark btn-lg px-4 d-flex align-items-center justify-content-center gap-2 rounded-pill">
                    <i class="fa-solid fa-phone"></i>
                    <span>Telefon ile Ara</span>
                </a>
            </div>

            @* Bilgi rozetleri *@
            <div class="d-flex flex-wrap gap-4 text-muted small">
                <span class="d-flex align-items-center gap-1">
                    <i class="fa-solid fa-truck-fast text-danger"></i> Hızlı Teslimat
                </span>
                <span class="d-flex align-items-center gap-1">
                    <i class="fa-solid fa-palette text-danger"></i> Logo Baskı Yapılır
                </span>
                <span class="d-flex align-items-center gap-1">
                    <i class="fa-solid fa-boxes-stacked text-danger"></i> Toplu Sipariş İndirimi
                </span>
            </div>
        </div>
    </div>

    @* Özellikler Tablosu *@
    @if (Model.ProductOptions != null && Model.ProductOptions.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 mb-5">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <h5 class="mb-0 fw-bold">
                    <i class="fa-solid fa-clipboard-list me-2 text-danger"></i>Ürün Özellikleri
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped mb-0">
                        <tbody>
                            @foreach (var option in Model.ProductOptions.OrderBy(o => o.DisplayOrder))
                            {
                                <tr>
                                    <th class="ps-4 py-3 text-muted fw-semibold"
                                        style="width:35%; background:#fafafa;">
                                        @option.Name
                                    </th>
                                    <td class="py-3 fw-medium">
                                        @(option.Values?.FirstOrDefault()?.Name ?? "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @* Benzer Ürünler *@
    @if (related != null && related.Any())
    {
        <div class="mb-4">
            <h4 class="fw-bold mb-1">Benzer Ürünler</h4>
            <p class="text-muted small">Aynı kategorideki diğer ürünleri inceleyin</p>
        </div>
        <div class="row g-4">
            @foreach (var item in related)
            {
                <div class="col-6 col-md-3">
                    <div class="card product-card h-100 border-0 shadow-sm">
                        <a href="/Products/@item.ProductCode" class="d-block text-decoration-none">
                            @if (!string.IsNullOrEmpty(item.MainImageUrl))
                            {
                                <img src="@item.MainImageUrl"
                                     class="card-img-top p-3 hover-zoom"
                                     alt="@item.ProductName"
                                     style="height:200px; object-fit:contain;">
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center p-3"
                                     style="height:200px; background:linear-gradient(135deg,#f8f9fa,#e9ecef); border-radius:8px 8px 0 0;">
                                    <i class="@GetCategoryIcon(item.Category?.CategoryName) fa-3x text-danger mb-2 opacity-75"></i>
                                    <span class="text-muted" style="font-size:0.72rem; text-align:center; padding:0 8px;">@item.ProductName</span>
                                </div>
                            }
                        </a>
                        <div class="card-body text-center d-flex flex-column">
                            <h6 class="fw-bold mb-1 text-dark" style="font-size:.85rem;">@item.ProductName</h6>
                            <small class="text-muted mb-2">@item.ProductCode</small>
                            <div class="mt-auto">
                                @if (item.Price.HasValue && item.Price.Value > 0)
                                {
                                    <p class="text-danger fw-bold mb-2">@item.Price.Value.ToString("C2")</p>
                                }
                                else
                                {
                                    <p class="text-muted small mb-2">Fiyat Sorunuz</p>
                                }
                                <a href="/Products/@item.ProductCode"
                                   class="btn btn-light btn-sm w-100 border stretched-link">
                                    İncele
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

<style>
    .product-main-img {
        transition: transform 0.4s ease;
    }

    .product-image-wrapper:hover .product-main-img {
        transform: scale(1.04);
    }

    .hover-zoom {
        transition: transform 0.3s ease;
    }

    .product-card:hover .hover-zoom {
        transform: scale(1.05);
    }

    .product-card {
        transition: box-shadow 0.3s;
    }

        .product-card:hover {
            box-shadow: 0 10px 25px rgba(0,0,0,0.1) !important;
        }

    .rounded-4 {
        border-radius: 1rem !important;
    }
</style>
