}

<section class="hero-section text-white text-center d-flex align-items-center justify-content-center">
    <video class="hero-video" id="heroVideo" autoplay muted playsinline disablepictureinpicture controlslist="nodownload nofullscreen noremoteplayback">
        <source src="~/videos/paint-ink-bg.mp4" type="video/mp4">
    </video>
    <div class="overlay"></div>
    <div class="container position-relative z-2">
        <h1 class="display-3 fw-bold mb-3">İşletmenizin <span class="text-hero-red">Kurumsal</span> Yüzü</h1>
        <p class="lead mb-4 mx-auto" style="max-width:700px; opacity:0.9;">
            Tabela, promosyon, matbaa ve dijital baskı çözümleriyle markanıza değer katıyoruz.
            Profesyonel tasarım ve kusursuz uygulama.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Products" asp-action="Index" class="btn btn-pro-red btn-lg px-5 hero-btn">
                <i class="fa-solid fa-magnifying-glass me-2"></i>ÜRÜNLERİ İNCELE
            </a>
            <a href="https://wa.me/@(Configuration.WhatsAppPhone())?text=Merhaba,%20detaylı%20bilgi%20almak%20istiyorum."
               target="_blank" class="btn btn-outline-light btn-lg px-5 hero-btn">
                <i class="fa-brands fa-whatsapp me-2"></i>BİZE ULAŞIN
            </a>
        </div>
    </div>
</section>

