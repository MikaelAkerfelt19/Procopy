@* Vitrin Ürünleri Bölümü *@
<section class="py-5 bg-white">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h6 class="text-danger fw-bold text-uppercase ls-1">Fırsat Ürünleri</h6>
                <h2 class="fw-bold mb-0">Vitrin Ürünleri</h2>
            </div>
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">Tümünü Gör</a>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-6 col-md-3">
                        <div class="card product-card h-100 border-0 shadow-sm">
                            <div class="position-relative">
                                <img src="@(string.IsNullOrEmpty(item.MainImageUrl) ? "https://placehold.co/400x400?text=Resim+Yok" : item.MainImageUrl)" class="card-img-top p-3" alt="@item.ProductName" style="height:250px; object-fit:contain;">
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3">Öne Çıkan</span>
                            </div>
                            <div class="card-body text-center d-flex flex-column">
                                <small class="text-muted text-uppercase mb-1" style="font-size:0.7rem;">@item.Category?.CategoryName</small>
                                <h5 class="card-title fw-bold text-dark h6 mb-3">@item.ProductName</h5>

                                <div class="mt-auto">
                                    @if (item.Price.HasValue && item.Price.Value > 0)
                                    {
                                        @if (item.OldPrice.HasValue && item.OldPrice.Value > item.Price.Value)
                                        {
                                            <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
                                                <span class="text-muted text-decoration-line-through small">@item.OldPrice.Value.ToString("C2")</span>
                                                <span class="text-danger fw-bold fs-5">@item.Price.Value.ToString("C2")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-primary fw-bold mb-3 fs-5">@item.Price.Value.ToString("C2")</p>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-secondary fw-bold mb-3 fs-6">Bize Ulaşınız</p>
                                    }

                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-light w-100 border stretched-link">İncele</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Şu anda vitrinde gösterilecek ürün bulunmuyor.</p>
                </div>
            }
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Ping-pong video efekti
        var video = document.getElementById('heroVideo');
        var forward = true;
        var step = 0.033; // ~30fps

        video.addEventListener('loadedmetadata', function() {
            video.play();
        });

        video.addEventListener('timeupdate', function() {
            if (forward) {
                if (video.currentTime >= video.duration - 0.1) {
                    forward = false;
                }
            }
        });

        video.addEventListener('ended', function() {
            forward = false;
            reversePingPong();
        });

        function reversePingPong() {
            var interval = setInterval(function() {
                if (video.currentTime <= 0.1) {
                    clearInterval(interval);
                    forward = true;
                    video.play();
                    return;
                }
                video.currentTime = Math.max(0, video.currentTime - step);
            }, 33);
        }
    });
</script>

<style>
    .hero-section {
        height: 500px;
        position: relative;
        overflow: hidden;
    }

    .hero-video {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        min-width: 100%;
        min-height: 100%;
        width: auto;
        height: auto;
        object-fit: cover;
        z-index: 0;
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        z-index: 1;
    }

    .text-hero-red {
        color: var(--pro-red, #dc3545);
    }

    .category-img-wrap {
        height: 160px;
        overflow: hidden;
    }

    .category-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .category-card:hover .category-img {
        transform: scale(1.07);
    }

    .border-bottom-red {
        border-bottom: 4px solid transparent;
        transition: 0.3s;
    }

        .border-bottom-red:hover {
            border-bottom: 4px solid var(--pro-red);
            transform: translateY(-5px);
        }

    .product-card {
        transition: 0.3s;
    }

        .product-card:hover {
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .mt-n5 {
        margin-top: -3rem !important;
        position: relative;
        z-index: 5;
    }

</style>