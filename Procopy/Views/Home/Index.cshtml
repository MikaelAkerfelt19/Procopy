@model List<Procopy.Models.Product>

@using Procopy.Models
@functions {
    string GetCategoryIcon(string categoryName)
    {
        if (string.IsNullOrEmpty(categoryName)) return "fa-solid fa-gift";
        var name = categoryName.ToLowerInvariant();
        if (name.Contains("kalem")) return "fa-solid fa-pen";
        if (name.Contains("defter") || name.Contains("ajanda")) return "fa-solid fa-book";
        if (name.Contains("usb") || name.Contains("bellek")) return "fa-solid fa-usb";
        if (name.Contains("power") || name.Contains("sarj")) return "fa-solid fa-battery-full";
        if (name.Contains("termos") || name.Contains("bardak")) return "fa-solid fa-mug-hot";
        if (name.Contains("saat")) return "fa-solid fa-clock";
        if (name.Contains("cakmak")) return "fa-solid fa-fire";
        if (name.Contains("tekstil") || name.Contains("tisort") || name.Contains("sapka") || name.Contains("polo")) return "fa-solid fa-shirt";
        if (name.Contains("canta")) return "fa-solid fa-briefcase";
        if (name.Contains("anahtarlik")) return "fa-solid fa-key";
        if (name.Contains("takvim")) return "fa-solid fa-calendar";
        if (name.Contains("bayrak")) return "fa-solid fa-flag";
        if (name.Contains("teknoloj") || name.Contains("mouse")) return "fa-solid fa-microchip";
        if (name.Contains("matbaa") || name.Contains("baski")) return "fa-solid fa-print";
        if (name.Contains("plaket") || name.Contains("odul")) return "fa-solid fa-award";
        if (name.Contains("etiket")) return "fa-solid fa-tags";
        if (name.Contains("semsiye")) return "fa-solid fa-umbrella";
        if (name.Contains("vip") || name.Contains("set")) return "fa-solid fa-box-open";
        if (name.Contains("tabela") || name.Contains("yonlendirme")) return "fa-solid fa-sign-hanging";
        if (name.Contains("restaurant") || name.Contains("cafe")) return "fa-solid fa-utensils";
        return "fa-solid fa-gift";
    }
}

@{
    ViewData["Title"] = "Ana Sayfa";
    var topCategories = ViewBag.TopCategories as List<Category>;
}

<section class="hero-section text-white text-center d-flex align-items-center justify-content-center">
    <div class="container position-relative z-2">
        <h1 class="display-3 fw-bold mb-3">İşletmenizin <span style="color:var(--pro-red)">Kurumsal</span> Yüzü</h1>
        <p class="lead mb-4 mx-auto" style="max-width: 700px; opacity:0.9;">
            Tabela, promosyon, matbaa ve dijital baskı çözümleriyle markanıza değer katıyoruz.
            Profesyonel tasarım ve kusursuz uygulama.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Products" asp-action="Index" class="btn btn-pro-red btn-lg px-5">
                <i class="fa-solid fa-magnifying-glass me-2"></i>ÜRÜNLERİ İNCELE
            </a>
            <a href="https://wa.me/905551234567?text=Merhaba,%20detaylı%20bilgi%20almak%20istiyorum."
               target="_blank" class="btn btn-outline-light btn-lg px-5">
                <i class="fa-brands fa-whatsapp me-2"></i>BİZE ULAŞIN
            </a>
        </div>
    </div>
    <div class="overlay"></div>
</section>

<section class="py-5 bg-light">
    <div class="container mt-n5">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

            @if (topCategories != null && topCategories.Any())
            {
                @foreach (var cat in topCategories)
                {
                    <div class="col">
                        <div class="category-card p-4 bg-white shadow-sm text-center h-100 border-bottom-red">
                            <div class="icon-box mb-3"><i class="@GetCategoryIcon(cat.CategoryName) fa-3x text-dark"></i></div>
                            <h3 class="fw-bold h6">@cat.CategoryName</h3>
                            <a href="/Products?category=@cat.Slug" class="text-danger fw-bold text-decoration-none small stretched-link">İncele <i class="fa-solid fa-arrow-right"></i></a>
                        </div>
                    </div>
                }
            }

            <div class="col">
                <div class="category-card p-4 bg-white shadow-sm text-center h-100 border-bottom-red">
                    <div class="icon-box mb-3"><i class="fa-solid fa-percent fa-3x text-danger"></i></div>
                    <h3 class="fw-bold h6 text-danger">İndirimli Fırsatlar</h3>
                    <a href="/Products?category=indirimli-firsatlar" class="text-danger fw-bold text-decoration-none small stretched-link">Fırsatları Gör <i class="fa-solid fa-arrow-right"></i></a>
                </div>
            </div>

        </div>
    </div>
</section>

@* Vitrin Ürünleri Bölümü *@
<section class="py-5 bg-white">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h6 class="text-danger fw-bold text-uppercase ls-1">Fırsat Ürünleri</h6>
                <h2 class="fw-bold mb-0">Vitrin Ürünleri</h2>
            </div>
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-dark rounded-pill px-4">Tümünü Gör</a>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="col-6 col-md-3">
                        <div class="card product-card h-100 border-0 shadow-sm">
                            <div class="position-relative">
                                <img src="@(string.IsNullOrEmpty(item.MainImageUrl) ? "https://placehold.co/400x400?text=Resim+Yok" : item.MainImageUrl)" class="card-img-top p-3" alt="@item.ProductName" style="height:250px; object-fit:contain;">
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3">Öne Çıkan</span>
                            </div>
                            <div class="card-body text-center d-flex flex-column">
                                <small class="text-muted text-uppercase mb-1" style="font-size:0.7rem;">@item.Category?.CategoryName</small>
                                <h5 class="card-title fw-bold text-dark h6 mb-3">@item.ProductName</h5>

                                <div class="mt-auto">
                                    @if (item.Price.HasValue && item.Price.Value > 0)
                                    {
                                        @if (item.OldPrice.HasValue && item.OldPrice.Value > item.Price.Value)
                                        {
                                            <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
                                                <span class="text-muted text-decoration-line-through small">@item.OldPrice.Value.ToString("C2")</span>
                                                <span class="text-danger fw-bold fs-5">@item.Price.Value.ToString("C2")</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <p class="text-primary fw-bold mb-3 fs-5">@item.Price.Value.ToString("C2")</p>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-secondary fw-bold mb-3 fs-6">Fiyat Sorunuz</p>
                                    }

                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductCode" class="btn btn-light w-100 border stretched-link">İncele</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">Şu anda vitrinde gösterilecek ürün bulunmuyor.</p>
                </div>
            }
        </div>
    </div>
</section>

@* Kampanya Modalı ve Scriptler değişmeden kalabilir *@

<div class="modal fade" id="campaignModal" tabindex="-1" aria-labelledby="campaignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg overflow-hidden">
            <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3 z-3 bg-white p-2 rounded-circle opacity-100" data-bs-dismiss="modal" aria-label="Kapat"></button>
            <div class="modal-body p-0">
                <div class="row g-0">
                    <div class="col-md-6 d-none d-md-block">
                        <img src="https://placehold.co/600x800/1a1a1a/FFF?text=Kampanya+Gorseli" class="img-fluid w-100 h-100 object-fit-cover" alt="Kampanya">
                    </div>
                    <div class="col-md-6 bg-danger text-white d-flex align-items-center">
                        <div class="p-5 text-center text-md-start">
                            <h5 class="text-uppercase ls-1 text-white-50 mb-2">Sınırlı Süre Fırsatı</h5>
                            <h2 class="fw-bold display-5 mb-3">Büyük İndirim Günleri!</h2>
                            <p class="lead mb-4" style="font-size: 1.1rem;">
                                Seçili promosyon ürünlerinde ve matbaa hizmetlerinde <strong>%50'ye varan</strong> indirimleri kaçırmayın.
                            </p>
                            <a href="/Products?category=indirimli-firsatlar" class="btn btn-light text-danger fw-bold py-3 px-5 rounded-pill shadow-sm hover-scale">
                                FIRSATLARI GÖR <i class="fa-solid fa-arrow-right ms-2"></i>
                            </a>
                            <div class="mt-4 text-white-50 small">*Stoklarla sınırlıdır.</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        if (!sessionStorage.getItem('popupshown')) {
            var myModal = new bootstrap.Modal(document.getElementById('campaignModal'));
            setTimeout(function() { myModal.show(); }, 1000);
            sessionStorage.setItem('popupshown', 'true');
        }
    });
</script>

<style>
    .hero-section {
        background: linear-gradient(45deg, #1a1a1a, #333);
        height: 500px;
        position: relative;
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1;
    }

    .border-bottom-red {
        border-bottom: 4px solid transparent;
        transition: 0.3s;
    }

        .border-bottom-red:hover {
            border-bottom: 4px solid var(--pro-red);
            transform: translateY(-5px);
        }

    .product-card {
        transition: 0.3s;
    }

        .product-card:hover {
            box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
        }

    .mt-n5 {
        margin-top: -3rem !important;
        position: relative;
        z-index: 5;
    }

    .hover-scale {
        transition: transform 0.2s;
    }

        .hover-scale:hover {
            transform: scale(1.05);
        }

    .z-3 {
        z-index: 3;
    }
</style>