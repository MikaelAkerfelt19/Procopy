<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProCopy Baskı Merkezi</title>

    @* Sekme ikonu — logodan üretilen kare varyantlar *@
    <link rel="icon" href="~/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="~/images/favicon-48.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/favicon-180.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Poppins:wght@500;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            /* LOGODAN ALINAN RENKLER */
            --pro-red: #D6001C;
            --pro-black: #1A1A1A;
            --pro-grey: #f4f4f4;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--pro-grey);
            color: #333;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* --- NAVBAR TASARIMI --- */
        .navbar {
            background-color: #ffffff;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            padding: 0.5rem 0; /* Logo büyük olacağı için paddingi biraz kıstım */
            border-bottom: 3px solid var(--pro-red);
        }

        .navbar-brand {
            padding: 0; /* Resim tam otursun */
            margin-right: 2rem;
        }

        /* LOGO BOYUTLANDIRMA - NAVBAR */
        .navbar-logo {
            height: 100px; /* Menüdeki logo yüksekliği */
            width: auto; /* Genişlik orantılı kalsın */
        }

        .nav-link {
            font-weight: 600;
            color: #444 !important;
            margin: 0 12px;
            transition: all 0.3s ease;
            text-transform: uppercase;
            font-size: 0.9rem;
        }

            .nav-link:hover, .nav-link.active {
                color: var(--pro-red) !important;
            }

        /* --- KIRMIZI BUTON TASARIMI --- */
        .btn-pro-red {
            background-color: var(--pro-red);
            color: white !important;
            border-radius: 4px;
            padding: 0.6rem 1.8rem;
            font-weight: 600;
            border: none;
            box-shadow: 0 4px 10px rgba(214, 0, 28, 0.3);
            transition: all 0.3s ease;
        }

            .btn-pro-red:hover {
                background-color: #b00017;
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(214, 0, 28, 0.4);
            }

        /* --- FOOTER TASARIMI --- */
        footer {
            background-color: var(--pro-black);
            color: #ccc;
            margin-top: auto;
            padding-top: 4rem;
            padding-bottom: 2rem;
            border-top: 5px solid var(--pro-red);
        }

            footer h5 {
                color: #fff;
                margin-bottom: 1.5rem;
                font-weight: 700;
                text-transform: uppercase;
                font-size: 1.1rem;
            }

        /* LOGO BOYUTLANDIRMA - FOOTER */
        .footer-logo {
            height: 100px; /* Footer'da logo biraz daha büyük olabilir */
            width: auto;
            margin-bottom: 1rem;
            filter: brightness(0) invert(1); /* Logoyu BEYAZ yapar (Siyah zemin üstünde güzel durur) */
            /* Eğer logonun orijinal renkleriyle kalmasını istersen üstteki filter satırını sil */
        }

        footer a {
            color: #bbb;
            text-decoration: none;
            transition: 0.3s;
            display: block;
            margin-bottom: 0.6rem;
        }

            footer a:hover {
                color: var(--pro-red);
                padding-left: 5px;
            }

        .footer-social a {
            display: inline-block;
            margin-right: 15px;
            font-size: 1.5rem;
            color: #fff;
        }

            .footer-social a:hover {
                color: var(--pro-red);
            }

    /* ===================== DİYAFRAM AÇILIŞ ANİMASYONU ===================== */
    #procopy-loader {
        position: fixed;
        inset: 0;
        background: #1A1A1A;
        z-index: 99999;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Diyafram kasası — tüm bıçakları barındırır, döner */
    .iris-wrap {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        animation: irisRotate 1.6s cubic-bezier(.4,0,.2,1) forwards;
    }

    /* Her bıçak: dar uzun elips, merkeze dayalı transform-origin */
    .iris-blade {
        position: absolute;
        width: 60vmax;
        height: 60vmax;
        background: var(--pro-red);
        border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
        /* Bıçakları merkezin hemen üstünde konumlandır */
        top: calc(-60vmax + 2vmax);
        left: -30vmax;
        transform-origin: 30vmax 60vmax; /* dönme ekseni: merkez */
        opacity: 0.95;
    }

    /* Her bıçak kendi açısına döndürülür */
    .iris-blade:nth-child(1) { transform: rotate(0deg); }
    .iris-blade:nth-child(2) { transform: rotate(60deg); }
    .iris-blade:nth-child(3) { transform: rotate(120deg); }
    .iris-blade:nth-child(4) { transform: rotate(180deg); }
    .iris-blade:nth-child(5) { transform: rotate(240deg); }
    .iris-blade:nth-child(6) { transform: rotate(300deg); }

    /* Tüm kasayı döndürerek kapanıp açılır */
    @@keyframes irisRotate {
        0%   { transform: translate(-50%,-50%) rotate(-70deg); opacity: 1; }  /* açık */
        40%  { transform: translate(-50%,-50%) rotate(0deg);   opacity: 1; }  /* kapandı */
        70%  { transform: translate(-50%,-50%) rotate(0deg);   opacity: 1; }  /* bekle */
        100% { transform: translate(-50%,-50%) rotate(-70deg); opacity: 0; }  /* açıldı + solar */
    }

    /* Merkezdeki logo */
    .iris-logo {
        position: relative;
        z-index: 1;
        width: clamp(80px, 15vw, 160px);
        filter: brightness(0) invert(1);
        animation: irisLogoFade 1.6s cubic-bezier(.4,0,.2,1) forwards;
    }

    @@keyframes irisLogoFade {
        0%   { opacity: 0; transform: scale(0.6); }
        35%  { opacity: 1; transform: scale(1);   }
        75%  { opacity: 1; transform: scale(1);   }
        100% { opacity: 0; transform: scale(1.1); }
    }
    /* ================================================================= */
    </style>
</head>
<body>

<!-- ===================== DİYAFRAM AÇILIŞ ANİMASYONU ===================== -->
@if (ViewContext.RouteData.Values["controller"]?.ToString()?.Equals("Home", StringComparison.OrdinalIgnoreCase) == true)
{
    <div id="procopy-loader">
        <div class="iris-wrap">
            <div class="iris-blade"></div>
            <div class="iris-blade"></div>
            <div class="iris-blade"></div>
            <div class="iris-blade"></div>
            <div class="iris-blade"></div>
            <div class="iris-blade"></div>
        </div>
        <img src="~/images/logo.png" alt="ProCopy" class="iris-logo">
    </div>
}
<!-- ================================================================= -->

    <header>
        <nav class="navbar navbar-expand-lg sticky-top">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="ProCopy Logo" class="navbar-logo">
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Kurumsal">Kurumsal</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">Ürünler</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">İletişim</a>
                        </li>

                        <li class="nav-item ms-lg-3">
                            <a class="btn btn-pro-red" href="https://wa.me/@(Configuration.WhatsAppPhone())?text=Merhaba,%20web%20sitenizden%20teklif%20almak%20istiyorum." target="_blank">
                                <i class="fa-brands fa-whatsapp me-2"></i>TEKLİF AL
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4">
                    <img src="~/images/logo.png" alt="ProCopy Logo" class="footer-logo">

                    <p class="small mt-2">Tasarım & Uygulama Merkezi. İşletmenizin kurumsal kimliği için profesyonel baskı çözümleri.</p>
                    <div class="footer-social mt-3">
                        <a href="#"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#"><i class="fa-brands fa-whatsapp"></i></a>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6 mb-4">
                    <h5>Hızlı Menü</h5>
                    <ul class="list-unstyled">
                        <li><a href="/Products?category=promosyon"><i class="fa-solid fa-angle-right me-2 small"></i>Promosyon Ürünleri</a></li>
                        <li><a href="/Products?category=tabela"><i class="fa-solid fa-angle-right me-2 small"></i>Tabela & Yönlendirme</a></li>
                        <li><a href="/Products?category=matbaa"><i class="fa-solid fa-angle-right me-2 small"></i>Matbaa & Baskı</a></li>
                        <li><a href="/Home/Contact"><i class="fa-solid fa-angle-right me-2 small"></i>İletişim</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12 mb-4">
                    <h5>Bize Ulaşın</h5>
                    <p class="small mb-2"><i class="fa-solid fa-location-dot me-2" style="color:var(--pro-red)"></i> Sahabiye Mahallesi, Otak Sokak No: 48/C, Melikgazi / KAYSERİ</p>
                    <p class="small mb-2"><i class="fa-solid fa-phone me-2" style="color:var(--pro-red)"></i> @Configuration.PhoneDisplay()</p>
                    <p class="small"><i class="fa-solid fa-envelope me-2" style="color:var(--pro-red)"></i> yilmazd38@gmail.com</p>
                </div>
            </div>

            <hr class="border-secondary my-4" style="opacity:0.2">

            <div class="d-flex justify-content-between align-items-center small text-secondary flex-wrap">
                <div>&copy; @DateTime.Now.Year ProCopy Baskı Merkezi.</div>
                <div>Yazılım: SeaSoft</div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        /* Diyafram animasyonu — her ziyarette çalışır, 1.8sn sonra DOM'dan kaldır */
        (function () {
            var loader = document.getElementById('procopy-loader');
            if (!loader) return;
            setTimeout(function () { loader.remove(); }, 1800);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>